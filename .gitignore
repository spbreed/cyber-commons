# ---- credentials: NEVER commit ----
# Kaggle tokens live in ~/.kaggle/kaggle.json (outside this repo) or in the
# environment. Nothing credential-shaped may enter git.
kaggle.json
.kaggle/
*.pem
*.key
.env
.env.*
!.env.example

# tool labs download and run real products; nothing there is source
labs/tools/*/work/
